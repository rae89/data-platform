# 1Password secret references, not secrets: safe to commit. `just up` resolves them with
# `op run` when the 1Password CLI is installed. Edit a path if your item lives elsewhere.
# Format: op://<vault>/<item>/<field>

# Read-only token for the portal's "Platform changes" feed (see .env.example for scopes).
GITHUB_TOKEN=op://Personal/data-platform-github-token/credential

# Superset: Flask secret key (signs sessions, encrypts stored credentials) and the
# password of its `admin` user. Item fields: secret_key, password.
SUPERSET_SECRET_KEY=op://Personal/data-platform-superset/secret_key
SUPERSET_ADMIN_PASSWORD=op://Personal/data-platform-superset/password
