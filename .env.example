# Without 1Password: copy to .env (gitignored) and fill in. docker compose reads .env.
# With the 1Password CLI installed, `just up` uses the references in .env.op instead.

# Read-only token for the portal's "Platform changes" feed (merged PRs of this repo).
# Create a fine-grained token at https://github.com/settings/personal-access-tokens/new
# with access to rae89/data-platform only and "Pull requests: Read-only" (plus the default
# "Metadata: Read-only"). Then run `just up`.
GITHUB_TOKEN=

# Superset (http://localhost:8088). Without these it exits and the rest still runs.
# Secret key: `openssl rand -base64 42`. Log in as `admin` with the password.
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_PASSWORD=

# Public deploy (infra/README.md). Hostnames the portal answers on, and where its links
# point (`just portal` reads PORTAL_PUBLIC_URL; {name} is the `public:` field in
# portal/catalog.yaml). Example for example.com:
# HOMEPAGE_ALLOWED_HOSTS=localhost:3002,portal.example.com
# PORTAL_PUBLIC_URL=https://{name}.example.com

# Public deploy: Superset signs people in with Cloudflare Access instead of its login
# page. Values: `tofu -chdir=infra output cf_access`. Listed emails get Admin, others a
# read-only role. Leave unset locally to keep the `admin` password login.
# CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
# CF_ACCESS_AUD=
# SUPERSET_ADMIN_EMAILS=you@example.com
