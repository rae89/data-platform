# 1Password references for `tofu apply` with a domain (public.tf). References, not
# secrets: safe to commit. Use: op run --env-file infra/.env.op -- tofu -chdir=infra apply
CLOUDFLARE_API_TOKEN=op://Personal/data-platform-cloudflare/credential
TF_VAR_google_client_secret=op://Personal/data-platform-google-oauth/client_secret
